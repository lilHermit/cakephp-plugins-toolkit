{
  "name": "lilhermit/cakephp-plugin-toolkit",
  "description": "Toolkit plugin for CakePHP-3",
  "type": "cakephp-plugin",
  "require": {
    "jdorn/sql-formatter": "^1.2.0"
  },
  "require-dev": {
    "cakephp/cakephp-codesniffer": "^5.0",
    "phpunit/phpunit": "^10.5.5 || ^11.1.3",
    "cakephp/cakephp": "3.3|^4.0|^5.0"
  },
  "autoload": {
    "psr-4": {
      "LilHermit\\Toolkit\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
